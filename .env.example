# Environment Variables Template
# Copy this file to .env and fill in your values. Never commit .env to version control!

# Backend Configuration
APP_NAME=Q-ALPHA Terminal
PORT=8000
HOST=127.0.0.1
DEBUG=False

# Quant Engine Caching
CACHE_DIR=backend/cache
CACHE_TTL_SECONDS=3600

# Market Data Feed (NSE India / Yahoo Finance)
MARKET_TIMEZONE=Asia/Kolkata
